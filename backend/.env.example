# === Base de datos ===
# En local usa SQLite automáticamente si se deja vacío.
# En producción (Supabase) pega tu PostgreSQL Connection String:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./asesor_ia.db

# === Seguridad JWT ===
SECRET_KEY=cambia-esta-clave-secreta-en-produccion-minimo-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=720

# === Proveedor de IA (gemini | groq | openrouter | ollama) ===
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Respaldo en nube u Ollama local (API compatible con OpenAI)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# === Sandbox de verificación de código (subprocess | docker) ===
SANDBOX_MODE=subprocess
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MEMORY_MB=256

# === Almacenamiento de archivos (local | supabase) ===
STORAGE_MODE=local
LOCAL_UPLOAD_DIR=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=submissions

# === CORS (orígenes permitidos separados por coma) ===
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
